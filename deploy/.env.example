# Copy to deploy/.env. Never commit the real file.
# Generate with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=sandpost
# Optional first boot admin (set both):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# The session cookie is Secure by default. That works over HTTPS (also behind a TLS
# terminating proxy) and on http://localhost in Chrome and Firefox. Set false only
# for plain http on another host name (LAN address) or in Safari on localhost:
# COOKIE_SECURE=false
